soong_config_module_type {
    name: "xiaomi_display_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "xiaomi_display",
    bool_variables: [
        "cwb_notify_sensor",
    ],
    properties: [
        "cflags",
        "shared_libs",
    ],
}

xiaomi_display_cc_defaults {
    name: "xiaomi_cwb_notify_defaults",
    soong_config_variables: {
        cwb_notify_sensor: {
            cflags: ["-DXIAOMI_CWB_NOTIFY_SENSOR"],
            shared_libs: [
                "//vendor/xiaomi/sm8750-common:libclient2slpi.notifier",
            ],
        },
    },
}

cc_library_headers {
    name: "display_debug_headers",
    vendor: true,
    export_include_dirs: [
        "libdebug",
    ],
}

cc_library_headers {
  name: "display_core_headers",
  vendor: true,
  export_include_dirs: [
    "include",
    "libdrmutils",
    "sdm/include",
  ],
  header_libs: [
      "libhardware_headers",
      "display_intf_headers",
      "display_debug_headers",
      "common_interface_headers",
      "snapalloc_interface_headers",
  ],
  export_header_lib_headers: [
      "libhardware_headers",
      "display_intf_headers",
      "display_debug_headers",
      "common_interface_headers",
      "snapalloc_interface_headers",
  ],
}
